# Environment configuration for dev-log-blog
# Copy this file to `.env` (local) or add the values as environment variables
# in your hosting provider (e.g. Vercel project settings).
# Do NOT commit real values — `.env*` is gitignored.

# GitHub login to display. Optional; source falls back to "MysteriousJose".
GITHUB_USERNAME=

# Optional GitHub personal access token (classic or fine-grained).
# Raises the GitHub API rate limit and unlocks the yearly contribution graph
# (the only metric that requires authentication). Leave blank for
# unauthenticated access to public data only.
GITHUB_TOKEN=

# Public site URL used by proxy.ts to gate direct image downloads
# (hotlink protection). The Referer/Origin host must match this URL's host
# exactly. Leave unset to disable the gate.
NEXT_PUBLIC_URL=
